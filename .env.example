# Copy to .env and fill in the secrets. Never commit .env.
# For local development, use hex passwords so they can be used in DATABASE_URL.
DATABASE_PASSWORD=
DATABASE_DB=rallly

# Garage RPC secret: exactly 64 hexadecimal characters.
GARAGE_RPC_SECRET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=rallly

SRH_MODE=env
SRH_TOKEN=
SRH_CONNECTION_STRING=redis://redis:6379

# Used by the VPS Garage initialization container.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=garage

# Required only when running the bundled Authentik services.
AUTHENTIK_PG_PASS=
AUTHENTIK_SECRET_KEY=

# VPS application settings; use Docker service addresses in DATABASE_URL.
DATABASE_URL=
SECRET_PASSWORD=
NEXT_PUBLIC_BASE_URL=
SUPPORT_EMAIL=
S3_ENDPOINT=http://garage:3900
S3_REGION=garage
KV_REST_API_URL=http://serverless-redis-http:80
KV_REST_API_TOKEN=
